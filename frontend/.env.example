# Base URL of the Sylithe backend API.
# REQUIRED — if unset, every fetch() resolves to "undefined/api/..." and the UI
# reports "Could not connect to server" on login and all other API calls.
#
# Local development (backend running via `python app.py`):
VITE_API_URL=http://127.0.0.1:5001

# Comma-separated emails allowed into the Verification section of the
# developer dashboard. Defaults to the platform owner when unset, so
# production behaviour is unchanged. Add your local dev account here.
VITE_SUPERUSER_EMAILS=karan270905@gmail.com,dev@sylithe.local
